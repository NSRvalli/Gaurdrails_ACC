# ---------- Simple analysis functions (heuristics) ----------
def build_risk_register(inventory):
    risks = []
    for item in inventory:
        comp_count = len(item.get("components", []))
        crit = {"low": 1, "medium": 2, "high": 3}.get(item.get("criticality", "medium"), 2)
        score = comp_count * crit
        risk_level = "HIGH" if score > 6 or item.get("sla", 99) > 4 else "MEDIUM" if score > 3 else "LOW"
        risks.append({
            "app_id": item.get("app_id"),
            "name": item.get("name"),
            "components": comp_count,
            "criticality": item.get("criticality"),
            "score": score,
            "risk_level": risk_level
        })
    return risks

def plan_kt(inventory):
    sessions = []
    for item in inventory:
        level = "Advanced" if item.get("criticality") == "high" else "Standard"
        session = {
            "app_id": item["app_id"],
            "app_name": item["name"],
            "level": level,
            "duration_hours": 2 if level == "Advanced" else 1,
            "sme": "AppOwner"
        }
        sessions.append(session)
    return sessions

def generate_sops(inventory):
    sops = []
    for item in inventory:
        sops.append({
            "app_id": item["app_id"],
            "title": f"SOP for {item['name']}",
            "steps_count": 5 + len(item.get("components", []))
        })
    return sops

def map_skills(inventory, resource_profiles):
    mapping = []
    for app in inventory:
        required = app.get("required_skills", [])
        matched = [r for r in resource_profiles if any(s in r.get("skills", []) for s in required)]
        mapping.append({
            "app_id": app["app_id"],
            "app_name": app["name"],
            "required_skills": ", ".join(required),
            "matched_resources": ", ".join(r["resource_id"] for r in matched),
            "gap_count": max(0, len(required) - len(matched))
        })
    return mapping

def identify_automation(ticket_history, sops):
    counts = {}
    for t in ticket_history:
        key = t.get("category", "general")
        counts[key] = counts.get(key, 0) + 1
    candidates = [{"category": k, "count": v, "suggested_automation": "RPA" if v > 5 else "Script"} for k, v in counts.items() if v > 1]
    return candidates

def sla_findings(slas, metrics):
    findings = []
    for s in slas:
        metric = metrics.get(s.get("app_id"), {})
        feasible = metric.get("available_teams", 0) >= s.get("on_call_required", 1)
        findings.append({
            "app_id": s.get("app_id"),
            "sla_hours": s.get("sla_hours"),
            "on_call_required": s.get("on_call_required"),
            "available_teams": metric.get("available_teams", 0),
            "feasible": feasible
        })
    return findings

def compute_maturity(knowledge_score, avg_complexity, kt_plan, risk_summary):
    read = knowledge_score
    kt_completion = 1 - min(1, len(kt_plan)/10)
    risk = 1 - min(1, risk_summary.get("high_risks_count", 0)/10)
    score = (read/5.0)*2.0 + (kt_completion)*1.5 + (risk)*1.5
    score = max(0.0, min(5.0, score))
    return {"maturity_score": round(score,2), "breakdown": {"readiness": read, "kt_completion": kt_completion, "risk_factor": risk}}

# ---------- Run mock pipeline ----------
