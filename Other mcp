def generate_charts_and_write(files_prefix: str, enriched: Dict[str, Any]):
    """Create charts and write Excel + HTML dashboard"""
    out_dir = os.path.dirname(files_prefix) or "."
    charts_dir = os.path.join(out_dir, "charts")
    os.makedirs(charts_dir, exist_ok=True)

    # Dataframes
    inv = enriched.get("inventory", [])
    df_inv = pd.DataFrame(inv)
    df_tickets = pd.DataFrame(enriched.get("tickets", []))
    sop_per_app = enriched.get("sop_readiness", {}).get("per_app", {})
    df_sop = pd.DataFrame([{"app_id":k, **v} for k,v in sop_per_app.items()]) if sop_per_app else pd.DataFrame()
    sla_findings = enriched.get("sla_feasibility", {}).get("findings", [])
    df_sla = pd.DataFrame(sla_findings)

    # Chart 1: Day-1 readiness gauge-like (bar)
    day1 = enriched.get("day1_readiness", {}).get("day1_pct", 0)
    fig, ax = plt.subplots(figsize=(4,2))
    ax.bar(["Day-1 Readiness"], [day1], color=['#1f77b4'])
    ax.set_ylim(0,100)
    ax.set_ylabel("Percent")
    ax.set_title("Day-1 Readiness")
    path_day1 = os.path.join(charts_dir, "day1_readiness.png")
    fig.savefig(path_day1, bbox_inches="tight"); plt.close(fig)

    # Chart 2: SOP completion per app
    if not df_sop.empty:
        fig, ax = plt.subplots(figsize=(6,3))
        ax.bar(df_sop["app_id"], df_sop["percent"])
        ax.set_ylim(0,100); ax.set_title("SOP Completion % per App")
        path_sop = os.path.join(charts_dir, "sop_completion.png")
        fig.savefig(path_sop, bbox_inches="tight"); plt.close(fig)
    else:
        path_sop = None

    # Chart 3: SLA feasibility counts
    if not df_sla.empty:
        df_sla["feasible_str"] = df_sla["feasible"].map({True:"Feasible", False:"Not Feasible"})
        counts = df_sla["feasible_str"].value_counts()
        fig, ax = plt.subplots(figsize=(4,2))
        ax.bar(counts.index.astype(str), counts.values)
        ax.set_title("SLA Feasibility")
        path_sla = os.path.join(charts_dir, "sla_feas.png")
        fig.savefig(path_sla, bbox_inches="tight"); plt.close(fig)
    else:
        path_sla = None

    # Chart 4: Skill gap (heatmap)
    skill_gap = enriched.get("skill_gap", {}).get("gap", {})
    if skill_gap:
        skills = list(skill_gap.keys())
        reqs = [skill_gap[s]["required"] for s in skills]
        avails = [skill_gap[s]["available"] for s in skills]
        fig, ax = plt.subplots(figsize=(6,3))
        x = np.arange(len(skills))
        ax.bar(x - 0.15, reqs, width=0.3, label="Required")
        ax.bar(x + 0.15, avails, width=0.3, label="Available")
        ax.set_xticks(x); ax.set_xticklabels(skills, rotation=45, ha='right')
        ax.legend(); ax.set_title("Skill Required vs Available")
        path_skill = os.path.join(charts_dir, "skill_gap.png")
        fig.savefig(path_skill, bbox_inches="tight"); plt.close(fig)
    else:
        path_skill = None

    # Chart 5: Automation candidates - ticket category counts
    auto = enriched.get("automation", {})
    ticket_candidates = auto.get("ticket_candidates", [])
    if ticket_candidates:
        cats = [t["category"] for t in ticket_candidates]
        counts = [t["count"] for t in ticket_candidates]
        fig, ax = plt.subplots(figsize=(5,2))
        ax.bar(cats, counts); ax.set_title("Automation Candidates (ticket categories)")
        path_auto = os.path.join(charts_dir, "automation_candidates.png")
        fig.savefig(path_auto, bbox_inches="tight"); plt.close(fig)
    else:
        path_auto = None

    # Excel output with embedded images
    excel_path = files_prefix + "_enhanced.xlsx"
    with pd.ExcelWriter(excel_path, engine="xlsxwriter") as writer:
        # Write dataframes
        df_inv.to_excel(writer, sheet_name="Inventory", index=False)
        df_tickets.to_excel(writer, sheet_name="Tickets", index=False)
        if not df_sop.empty: df_sop.to_excel(writer, sheet_name="SOPs", index=False)
        if not df_sla.empty: df_sla.to_excel(writer, sheet_name="SLA_Findings", index=False)
        # Summary sheet
        summary = {
            "maturity_score": enriched.get("knowledge",{}).get("readiness_score"),
            "day1_readiness_pct": day1,
            "sop_overall_pct": enriched.get("sop_readiness",{}).get("overall_pct"),
            "automation_monthly_value_estimate": enriched.get("automation",{}).get("monthly_value_estimate")
        }
        pd.DataFrame([summary]).to_excel(writer, sheet_name="Summary", index=False)
        workbook = writer.book
        # Insert images
        sh = writer.sheets["Summary"]
        sh.insert_image("H2", path_day1)
        if path_sop:
            sh.insert_image("H20", path_sop)
        if path_sla:
            sh.insert_image("H40", path_sla)
        if path_skill:
            sh.insert_image("H60", path_skill)
        if path_auto:
            sh.insert_image("H80", path_auto)
    print("Excel written:", excel_path)

    # HTML dashboard (single page)
    html_path = files_prefix + "_enhanced.html"
    with open(html_path, "w") as fh:
        fh.write("<html><head><meta charset='utf-8'><title>Transition Dashboard</title></head><body>")
        fh.write(f"<h1>Project: {enriched.get('project','-')}</h1>")
        fh.write("<h2>Executive Summary</h2><ul>")
        fh.write(f"<li>Maturity (knowledge): {enriched.get('knowledge',{}).get('readiness_score')}</li>")
        fh.write(f"<li>Day-1 Readiness %: {day1}</li>")
        fh.write(f"<li>SOP overall %: {enriched.get('sop_readiness',{}).get('overall_pct')}</li>")
        fh.write("</ul>")
        fh.write("<h2>Charts</h2>")
        fh.write(f"<h3>Day-1 Readiness</h3><img src='{path_day1}' width='600'/>")
        if path_sop: fh.write(f"<h3>SOP Completion</h3><img src='{path_sop}' width='700'/>")
        if path_sla: fh.write(f"<h3>SLA Feasibility</h3><img src='{path_sla}' width='400'/>")
        if path_skill: fh.write(f"<h3>Skill Gap</h3><img src='{path_skill}' width='700'/>")
        if path_auto: fh.write(f"<h3>Automation Candidates</h3><img src='{path_auto}' width='600'/>")
        fh.write("</body></html>")
    print("HTML written:", html_path)

    return {"excel": excel_path, "html": html_path, "charts_dir": charts_dir}

# ---------------------------
# Orchestration
# ---------------------------
def enrich_and_generate(input_path: str, output_prefix: str):
    data = load_input(input_path)
    # Compute day1 inputs: either provided or compute heuristically
    day1_inputs = data.get("day1_inputs", {})
    # If not present, attempt to infer: e.g., env_ready true if >0 infra metrics present (heuristic)
    if not day1_inputs:
        day1_inputs = {
            "access": bool(data.get("sops")),
            "monitoring": True,
            "env_ready": False,
            "oncall_roster": True,
            "sop_done_pct": 0.5
        }
    day1 = calculate_day1_readiness(day1_inputs)
    sops = data.get("sops", [])
    sop_read = calculate_sop_readiness(sops, data.get("inventory", []))
    sla_find = calculate_sla_feasibility(data.get("slas", []), data.get("metrics", {}))
    skill_gap = compute_skill_gap(data.get("inventory", []), data.get("resource_profiles", []))
    automation = identify_automation_opportunities(data.get("tickets", []), sops, data.get("automation", {}))
    # integrate into enriched payload
    enriched = dict(data)  # shallow copy
    enriched["day1_readiness"] = day1
    enriched["sop_readiness"] = sop_read
    enriched["sla_feasibility"] = sla_find
    enriched["skill_gap"] = skill_gap
    enriched["automation"] = automation
    # tollgate checks
    toll = perform_tollgate_checks(enriched)
    enriched["tollgate"] = toll
    # wave planner
    waves = wave_planner_suggest(data.get("inventory", []), enriched)
    enriched["wave_planner"] = waves
    # executive summary computed
    enriched["executive_summary"] = {
        "maturity": data.get("knowledge", {}).get("readiness_score"),
        "day1_pct": day1.get("day1_pct"),
        "sop_pct": sop_read.get("overall_pct"),
        "tollgate_pass": toll.get("overall")
    }
    # write enriched JSON
    enriched_path = output_prefix + "_enriched.json"
    write_json(enriched_path, enriched)
    print("Enriched JSON written:", enriched_path)
    # generate charts & reports
    reports = generate_charts_and_write(output_prefix, enriched)
    return {"enriched_json": enriched_path, **reports}

# ---------------------------
# CLI
# ---------------------------
def main():
    parser = argparse.ArgumentParser(description="Generate enterprise KPIs & dashboards from MCP transition JSON")
    parser.add_argument("--input", "-i", type=str, default="sample", help="Path to transition_output.json or 'sample'")
    parser.add_argument("--out-prefix", "-o", type=str, default="transition_dashboard", help="Output files prefix")
    args = parser.parse_args()
    res = enrich_and_generate(args.input, args.out_prefix)
    print("Finished. Outputs:", res)

if __name__ == "__main__":
    main()
