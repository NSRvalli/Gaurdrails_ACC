        return json.load(fh)

def write_json(path: str, payload: Dict[str, Any]):
    with open(path, "w") as fh:
        json.dump(payload, fh, indent=2, default=str)

# ---------------------------
# KPI calculations
# ---------------------------
def calculate_day1_readiness(day1_inputs: Dict[str, Any]) -> Dict[str, Any]:
    """
    Weighted scoring template. Returns percentage 0-100.
    Weights can be externalised to config.
    """
    # weights (configurable)
    weights = {
        "access": 20,
        "monitoring": 20,
        "env_ready": 25,
        "oncall_roster": 15,
        "sop_done_pct": 20
    }
    score = 0.0
    score += weights["access"] if day1_inputs.get("access") else 0
    score += weights["monitoring"] if day1_inputs.get("monitoring") else 0
    score += weights["env_ready"] if day1_inputs.get("env_ready") else 0
    score += weights["oncall_roster"] if day1_inputs.get("oncall_roster") else 0
    # sop_done_pct is between 0-1
    score += weights["sop_done_pct"] * float(day1_inputs.get("sop_done_pct", 0))
    return {"day1_pct": round(score,2), "breakdown": weights}

def calculate_sop_readiness(sops: List[Dict[str, Any]], inventory: List[Dict[str, Any]]) -> Dict[str, Any]:
    """
    Returns per-app SOP completion % and overall.
    If sops list is not per-app complete, uses heuristics.
    """
    req = {}
    for app in inventory:
        req[app["app_id"]] = {"required": 1, "completed": 0}  # minimal default
    for s in sops:
        aid = s.get("app_id")
        if aid not in req:
            req[aid] = {"required": 1, "completed": 0}
        req[aid]["required"] += 0  # keep placeholder
        if s.get("status") == "completed":
            req[aid]["completed"] += 1
    # compute %
    per_app = {}
    completed_counts = []
    for aid, vals in req.items():
        # avoid divide by zero
        denom = vals["required"] if vals["required"]>0 else 1
        pct = (vals["completed"] / denom) * 100
        per_app[aid] = {"required": vals["required"], "completed": vals["completed"], "percent": round(pct,2)}
        completed_counts.append(pct)
    overall = round(sum(completed_counts)/len(completed_counts),2) if completed_counts else 0.0
    return {"per_app": per_app, "overall_pct": overall}

def calculate_sla_feasibility(slas: List[Dict[str, Any]], metrics: Dict[str, Any]) -> Dict[str, Any]:
    """
    For each SLA record (expected application), check metric capacity.
    Feasibility rule: available_teams >= on_call_required (simple)
    """
    findings = []
    infeasible = 0
    for s in slas:
        app_id = s.get("app_id")
        metric = metrics.get(app_id, {})
        available = metric.get("available_teams", 0)
        required = s.get("on_call_required", 1)
        feasible = available >= required
        findings.append({
            "app_id": app_id,
            "sla_hours": s.get("sla_hours"),
            "on_call_required": required,
            "available_teams": available,
            "feasible": feasible
        })
        if not feasible:
            infeasible += 1
    summary = {"total_slas": len(slas), "infeasible_count": infeasible}
    return {"findings": findings, "summary": summary}

def compute_skill_gap(inventory: List[Dict[str, Any]], resource_profiles: List[Dict[str, Any]]) -> Dict[str, Any]:
    """
    Produces a matrix of required skills vs available count.
    """
    required_counts = {}
    for a in inventory:
        for s in a.get("required_skills", []):
            required_counts[s] = required_counts.get(s, 0) + 1
    available_counts = {}
    for r in resource_profiles:
        for s in r.get("skills", []):
            available_counts[s] = available_counts.get(s, 0) + 1
    # compute gap per skill
    gap = {}
    for skill, req_count in required_counts.items():
        avail = available_counts.get(skill, 0)
        gap[skill] = {"required": req_count, "available": avail, "gap": max(0, req_count - avail)}
    return {"required": required_counts, "available": available_counts, "gap": gap}

def identify_automation_opportunities(tickets: List[Dict[str, Any]], sops: List[Dict[str, Any]], automation_config: Dict[str, Any]) -> Dict[str, Any]:
    """
    Heuristic-based identification:
     - categories with repeated tickets
     - SOPs with many manual steps (if steps_count provided)
    Returns candidates and an ROI estimate.
    """
    # ticket category counts
    cat_counts = {}
    for t in tickets:
        k = t.get("category", "general")
        cat_counts[k] = cat_counts.get(k, 0) + 1
    ticket_candidates = []
    for c, count in cat_counts.items():
        if count >= 2:  # threshold configurable
            ticket_candidates.append({"category": c, "count": count, "suggested": "Script" if count < 6 else "RPA"})
    # SOP manual step heuristic (if steps_count in sops)
    sop_candidates = []
    for s in sops:
        if s.get("steps_count", 0) > 10:
            sop_candidates.append({"app_id": s.get("app_id"), "title": s.get("title"), "steps_count": s.get("steps_count"), "suggested": "Automation (RPA/Script)"})
    # ROI estimate: hours saved = monthly_tickets * automatable_pct * avg_effort_mins / 60
    est = automation_config or {"estimated_monthly_tickets": 0, "automatable_pct": 0.0, "avg_effort_per_ticket_mins": 0}
    hours_saved = est["estimated_monthly_tickets"] * est["automatable_pct"] * (est["avg_effort_per_ticket_mins"]/60.0)
    # assume rate param (configurable)
    hourly_rate = est.get("hourly_value", 25)
    monthly_value = round(hours_saved * hourly_rate, 2)
    return {"ticket_candidates": ticket_candidates, "sop_candidates": sop_candidates, "hours_saved_monthly": hours_saved, "monthly_value_estimate": monthly_value}

def perform_tollgate_checks(enriched: Dict[str, Any], thresholds: Dict[str, Any]=None) -> Dict[str, Any]:
    """
    Basic pass/fail rules for tollgates. thresholds is configurable.
    Example rules:
      - Day1 readiness >= 70
      - SOP overall_pct >= 70
      - Open P0/P1 <= 2
    """
    if thresholds is None:
        thresholds = {"day1_pct": 70, "sop_pct": 70, "max_critical_open": 2}
    day1 = enriched.get("day1_readiness", {}).get("day1_pct", 0)
    sop_pct = enriched.get("sop_readiness", {}).get("overall_pct", 0)
    # count open critical tickets
    tickets = enriched.get("tickets", [])
    open_crit = len([t for t in tickets if t.get("priority") in ("P0","P1") and t.get("status")!="closed"])
    pass_readiness = day1 >= thresholds["day1_pct"]
    pass_sop = sop_pct >= thresholds["sop_pct"]
    pass_risk = open_crit <= thresholds["max_critical_open"]
    overall = pass_readiness and pass_sop and pass_risk
    return {"passes": {"readiness": pass_readiness, "sop": pass_sop, "risk": pass_risk}, "overall": overall, "open_critical_count": open_crit}

def wave_planner_suggest(inventory: List[Dict[str, Any]], enriched: Dict[str, Any]) -> Dict[str, Any]:
    """
    Simple heuristic: assign apps to waves based on risk score (complexity*criticality) and SOP readiness.
    returns a dict of waves -> list of app_ids
    """
    risk_register = []
    # compute app-level risk score
    for a in inventory:
        comp_count = len(a.get("components", []))
        crit_weight = 3 if a.get("criticality")=="high" else 2 if a.get("criticality")=="medium" else 1
        score = comp_count * crit_weight
        sop_pct = enriched.get("sop_readiness", {}).get("per_app", {}).get(a["app_id"], {}).get("percent", 0)
        # lower sop_pct increases risk priority
        penalty = 0 if sop_pct >= 80 else 1
        risk_register.append({"app_id": a["app_id"], "name": a["name"], "score": score+penalty})
    # sort desc
    sorted_apps = sorted(risk_register, key=lambda x: x["score"], reverse=True)
    # create waves: wave1 = top N , wave2 = next N, wave3 = rest (N can be dynamic)
    N = max(1, math.ceil(len(sorted_apps)/3))
    waves = {"wave_1": [a["app_id"] for a in sorted_apps[:N]],
             "wave_2": [a["app_id"] for a in sorted_apps[N:2*N]],
             "wave_3": [a["app_id"] for a in sorted_apps[2*N:]]}
    return {"risk_register": risk_register, "wave_plan": waves}

